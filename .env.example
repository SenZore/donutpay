PAYMENT_PROVIDER=pakasir
PAYMENT_MODE=sandbox

# Pakasir (app.pakasir.com → project → slug & api key)
PAKASIR_SLUG=
PAKASIR_API_KEY=

# Midtrans (dashboard.sandbox.midtrans.com → Settings → Access Keys)
MIDTRANS_SERVER_KEY=

# Bot Minecraft (akun Microsoft, login sekali via npm run login)
MC_HOST=donutsmp.net
MC_PORT=25565
MC_USERNAME=
MC_VERSION=1.21.1
MC_AUTH_CACHE=./auth_cache

# DonutSMP API key (in-game /api) — untuk tampilkan stok balance bot
DONUT_API_KEY=

ADMIN_USER=admin
ADMIN_PASSWORD=ganti-ini

# Rupiah per 1 juta donut
RATE=2000

PORT=3000

# Set 1 hanya kalau app di belakang Cloudflare (tunnel/proxy) —
# header cf-connecting-ip baru dipercaya untuk rate-limit kalau ini 1.
TRUST_CF_HEADER=0
